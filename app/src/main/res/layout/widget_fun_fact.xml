<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fun_fact_widget"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widgetBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fun_fact_widget_badge"
        android:fontFamily="monospace"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textAllCaps="true"
        android:textColor="#001216"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetFactText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="top"
        android:maxLines="5"
        android:textColor="#F5F7FA"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textColor="#98A6B3"
        android:textSize="12sp" />
</LinearLayout>
